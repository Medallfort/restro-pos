# Copie had l-fichier l ".env" (ma kaytcommitach) w bddel les valeurs.
NODE_ENV=development
HOST=127.0.0.1
PORT=8000

# Docker: mongodb://mongo:27017/restro
MONGODB_URI=mongodb://127.0.0.1:27017/restro

# Secret dyal JWT: 32 caractères 3la l-a9al. Generer wa7d b:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL_HOURS=12

# true f production (HTTPS). false ghir ila l-app kat-servi b HTTP.
COOKIE_SECURE=false

# Ch7al dyal reverse proxies 9dam l-backend (Nginx = 1)
TRUST_PROXY=0

TAX_RATE=5.25

# Optionnel: paiement en ligne (khass jouj b jouj, sinon kayt-desactiva)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Origins mssmo7in (CORS), mfr9in b virgule. Khawya ila frontend kaykhdem b proxy (Vite/Nginx)
CORS_ORIGINS=
